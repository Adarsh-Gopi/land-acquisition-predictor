<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Predictive Analytics - Land Acquisition' %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-navy shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/">
                <span class="badge bg-warning text-dark p-2 rounded-circle">
                    <i class="bi bi-geo-alt-fill"></i>
                </span>
                <span>Land<span class="text-teal">Predict</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link text-white-50 hover-white" href="/"><i class="bi bi-house-door me-1"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 hover-white" href="/predict"><i class="bi bi-plus-circle me-1"></i> New Assessment</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 hover-white" href="/dashboard"><i class="bi bi-bar-chart-line me-1"></i> Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 hover-white" href="/map"><i class="bi bi-map me-1"></i> GIS Map</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 hover-white" href="/alerts"><i class="bi bi-bell me-1"></i> Alerts</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50 hover-white" href="/history"><i class="bi bi-clock-history me-1"></i> History</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-teal-subtle text-teal px-3 py-2 rounded-pill border border-teal">
                        <i class="bi bi-cpu me-1"></i> Dual XGBoost Active
                    </span>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main class="flex-grow-1">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white-50 py-4 mt-auto border-top border-secondary">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <span class="fw-semibold text-white">Predictive Analytics System for Early Detection of Land Acquisition Delays</span>
                    <p class="small mb-0">Smart India Hackathon (SIH) Prototype • Ministry of Railways & Road Infrastructure</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="badge bg-secondary me-2">FastAPI Microservice</span>
                    <span class="badge bg-secondary me-2">XGBoost ML</span>
                    <span class="badge bg-secondary">MongoDB</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="/js/script.js"></script>
</body>
</html>
