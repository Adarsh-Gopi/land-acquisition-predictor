<% layout('layouts/boilerplate') %>

<%
// Safe fallback initialization to prevent any ReferenceError or TypeError
const item = (typeof caseItem !== 'undefined' && caseItem) ? caseItem : {
    case_id: 'DEMO-LA-2026',
    project_name: 'High-Speed Infrastructure Corridor',
    state: 'Uttar Pradesh',
    district_type: 'Rural',
    project_type: 'Railway',
    land_type: 'Agricultural',
    notification_stage: '3A issued',
    land_area_acres: 8.2,
    land_area_hectares: 3.32,
    affected_owner_count: 12,
    compensation_estimate_inr_lakh: 350.0,
    compensation_funding_available: 0,
    is_multi_village: 1,
    days_since_case_opened: 240,
    award_completed_percent: 30.0,
    compensation_disbursed_percent: 15.0,
    possession_completed_percent: 0.0,
    delay_probability: 0.911,
    delay_probability_percent: '91.1%',
    risk_level: 'High',
    is_delayed_predicted: 1,
    risk_distribution: { low: 0.002, medium: 0.011, high: 0.988 },
    top_risk_factors: [
        'Active court litigation pending',
        'Ownership title dispute among claimants',
        'Section 3C/Section 15 public objections filed',
        'Compensation funds not yet deposited in escrow'
    ],
    recommended_preventive_actions: [
        'Prioritize government legal counsel hearings and consider Section 64 reference fast-tracking.',
        'Deposit disputed share into competent authority court escrow while proceeding with uncontested parcels.',
        'Convene direct CALA hearing to address objections on valuation and alignment.',
        'Expedite budgetary sanction and treasury transfer to avoid statutory compensation interest penalty.'
    ],
    processing_time_ms: 57.8,
    warning: null
};

const riskLevel = item.risk_level || 'Medium';
const riskDist = item.risk_distribution || { low: 0, medium: 0, high: 0 };
const factors = Array.isArray(item.top_risk_factors) ? item.top_risk_factors : [];
const actions = Array.isArray(item.recommended_preventive_actions) ? item.recommended_preventive_actions : [];
const shapData = Array.isArray(item.shap_explanations) ? item.shap_explanations : [];
const probPercent = item.delay_probability_percent || `${Math.round((item.delay_probability || 0) * 100)}%`;
const probVal = typeof item.delay_probability === 'number' ? item.delay_probability : 0.5;
const progressWidth = Math.min(Math.max(Math.round(probVal * 100), 0), 100);
const progressWidthPercent = `${progressWidth}%`;

const lowDistPercent = `${((riskDist.low || 0) * 100).toFixed(1)}%`;
const medDistPercent = `${((riskDist.medium || 0) * 100).toFixed(1)}%`;
const highDistPercent = `${((riskDist.high || 0) * 100).toFixed(1)}%`;
const awardPercentStr = `${item.award_completed_percent || 0}%`;
const possessionPercentStr = `${item.possession_completed_percent || 0}%`;
%>

<div class="container py-5">

    <% if (item.warning) { %>
        <div class="alert alert-dismissible fade show shadow-sm rounded-4 mb-4" role="alert" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); color: #FDE68A;">
            <i class="bi bi-exclamation-circle-fill me-2 text-warning"></i> <strong>Notice:</strong> <%= item.warning %>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Result Header Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="p-4 p-md-5 text-white <%= riskLevel === 'High' ? 'bg-gradient-danger' : (riskLevel === 'Medium' ? 'bg-gradient-warning text-dark' : 'bg-gradient-success') %>">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge px-3 py-2 rounded-pill fw-bold mb-2" style="background: #181818; color: #E2E8F0; border: 1px solid rgba(255,255,255,0.12);">
                        <i class="bi bi-folder2 me-1"></i> Case ID: <%= item.case_id || 'N/A' %>
                    </span>
                    <h2 class="fw-extrabold mb-1 text-white"><%= item.project_name || 'Land Acquisition Project' %></h2>
                    <p class="mb-0" style="color: #E2E8F0; opacity: 0.9;">
                        <i class="bi bi-geo-alt me-1"></i> <%= item.state || 'N/A' %> (<%= item.district_type || 'N/A' %>) • Sector: <%= item.project_type || 'N/A' %> • Land: <%= item.land_area_acres || 0 %> Acres (<%= item.land_area_hectares || 0 %> Ha)
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-4 mt-md-0">
                    <div class="d-inline-block p-3 p-md-4 rounded-4 text-center" style="background: #181818; border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);">
                        <span class="small text-uppercase fw-bold d-block" style="color: #94A3B8;">Assigned Risk Tier</span>
                        <h2 class="fw-extrabold mb-0 <%= riskLevel === 'High' ? 'text-danger' : (riskLevel === 'Medium' ? 'text-warning' : 'text-success') %>">
                            <%= riskLevel %> Risk
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-4 border-top" style="background: #1E1E1E; border-color: rgba(255, 255, 255, 0.08) !important;">
            <div class="row g-4 align-items-center">
                <div class="col-md-4 text-center border-end" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                    <span class="small fw-semibold text-uppercase" style="color: #94A3B8;">Delay Probability</span>
                    <h1 class="fw-extrabold mb-1 <%= riskLevel === 'High' ? 'text-danger' : (riskLevel === 'Medium' ? 'text-warning' : 'text-success') %>">
                        <%= probPercent %>
                    </h1>
                    <div class="progress mt-2" style="height: 10px; background-color: #121212; border: 1px solid rgba(255,255,255,0.06); border-radius: 999px;">
                        <div id="delayProgressBar"
                             class="progress-bar <%= riskLevel === 'High' ? 'bg-danger' : (riskLevel === 'Medium' ? 'bg-warning' : 'bg-success') %>" 
                             role="progressbar" 
                             aria-valuenow="<%= progressWidth %>" 
                             aria-valuemin="0" 
                             aria-valuemax="100"
                             data-width="<%= progressWidth %>"
                             style="border-radius: 999px;">
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center border-end" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                    <span class="small fw-semibold text-uppercase" style="color: #94A3B8;">Probability Breakdown</span>
                    <div class="d-flex justify-content-center gap-3 mt-2">
                        <div>
                            <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.25);">Low</span>
                            <div class="fw-bold text-white mt-1"><%= lowDistPercent %></div>
                        </div>
                        <div>
                            <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.25);">Medium</span>
                            <div class="fw-bold text-white mt-1"><%= medDistPercent %></div>
                        </div>
                        <div>
                            <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.25);">High</span>
                            <div class="fw-bold text-white mt-1"><%= highDistPercent %></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <span class="small fw-semibold text-uppercase" style="color: #94A3B8;">Inference Latency</span>
                    <h4 class="fw-bold mb-1 text-white"><%= item.processing_time_ms || 0 %> ms</h4>
                    <span class="badge px-3 py-1.5" style="background: #121212; color: #CBD5E1; border: 1px solid rgba(255, 255, 255, 0.1);">Sub-second Realtime</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Details and Action Columns -->
    <div class="row g-4">
        
        <!-- Left: Bottleneck Drivers & Mitigations -->
        <div class="col-lg-7">
            <!-- Top Risk Factors -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-exclamation-octagon-fill text-danger me-2"></i> Identified Critical Bottlenecks</h5>
                <% if (factors.length > 0) { %>
                    <div class="d-flex flex-column gap-2">
                        <% factors.forEach(function(factor) { %>
                            <div class="d-flex align-items-center p-3 rounded-3" style="background: #181818; border: 1px solid rgba(255, 255, 255, 0.06);">
                                <i class="bi bi-x-circle-fill text-danger me-2 fs-5"></i>
                                <span class="fw-semibold text-white"><%= factor %></span>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-muted mb-0">No severe bottleneck triggers identified.</p>
                <% } %>
            </div>

            <!-- SHAP Explainability Chart -->
            <% if (shapData.length > 0) { %>
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-white mb-1">
                    <i class="bi bi-diagram-3-fill text-primary me-2"></i> AI Explainability (SHAP)
                </h5>
                <p class="small mb-3" style="color: #94A3B8;">How much each feature contributes to the predicted delay probability — as learned by the XGBoost model.</p>
                <div style="height: 260px;">
                    <canvas id="shapChart"></canvas>
                </div>
                <div class="d-flex gap-3 mt-2 small" style="color: #CBD5E1;">
                    <span><span style="display:inline-block;width:12px;height:12px;background:#dc3545;border-radius:2px;margin-right:4px;"></span>Increases delay risk</span>
                    <span><span style="display:inline-block;width:12px;height:12px;background:#198754;border-radius:2px;margin-right:4px;"></span>Reduces delay risk</span>
                </div>
            </div>
            <% } %>

            <!-- Recommended Preventive Actions -->
            <div class="card border-0 shadow-sm rounded-4 p-4" style="border-left: 4px solid #06B6D4 !important;">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-clipboard-check-fill me-2" style="color: #06B6D4;"></i> Recommended Officer Preventive Actions</h5>
                <% if (actions.length > 0) { %>
                    <div class="d-flex flex-column gap-3">
                        <% actions.forEach(function(action, idx) { %>
                            <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background: #181818; border: 1px solid rgba(255, 255, 255, 0.06);">
                                <span class="badge rounded-circle px-2 py-1" style="background: #06B6D4; color: #0F172A; font-weight: bold;"><%= idx + 1 %></span>
                                <span style="color: #E2E8F0;"><%= action %></span>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-muted mb-0">Standard milestone tracking recommended.</p>
                <% } %>
            </div>
        </div>

        <!-- Right: Case Parameter Snapshot -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-white mb-3"><i class="bi bi-info-circle-fill text-primary me-2"></i> Case Profile Summary</h5>
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-2" style="color: #94A3B8;">Landowners Affected</td>
                            <td class="fw-bold text-end py-2 text-white"><%= item.affected_owner_count || 0 %> Owners</td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-2" style="color: #94A3B8;">Compensation Amount</td>
                            <td class="fw-bold text-end py-2 text-white">₹ <%= item.compensation_estimate_inr_lakh || 0 %> Lakhs</td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-2" style="color: #94A3B8;">Funding In Escrow</td>
                            <td class="fw-bold text-end py-2">
                                <span class="badge <%= item.compensation_funding_available ? 'bg-success' : 'bg-danger' %>">
                                    <%= item.compensation_funding_available ? 'Available' : 'Pending' %>
                                </span>
                            </td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-2" style="color: #94A3B8;">Multi-Village Jurisdiction</td>
                            <td class="fw-bold text-end py-2 text-white"><%= item.is_multi_village ? 'Yes' : 'No' %></td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-2" style="color: #94A3B8;">Current Notification</td>
                            <td class="fw-bold text-end py-2 text-white"><%= item.notification_stage || 'N/A' %></td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-2" style="color: #94A3B8;">Days Elapsed</td>
                            <td class="fw-bold text-end py-2 text-white"><%= item.days_since_case_opened || 0 %> Days</td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <td class="py-2" style="color: #94A3B8;">Award Declared</td>
                            <td class="fw-bold text-end py-2 text-white"><%= awardPercentStr %></td>
                        </tr>
                        <tr>
                            <td class="py-2" style="color: #94A3B8;">Physical Possession</td>
                            <td class="fw-bold text-end py-2 text-white"><%= possessionPercentStr %></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Bottom Navigation -->
            <div class="d-flex gap-3 mt-4">
                <a href="/predict" class="btn btn-primary-pill flex-grow-1 py-2.5 fw-bold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-plus-circle me-1"></i> New Assessment
                </a>
                <a href="/history" class="btn flex-grow-1 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2" style="background: #242424; color: #FFFFFF; border: 1px solid rgba(255,255,255,0.15); border-radius: 9999px;">
                    <i class="bi bi-card-list me-1"></i> View All History
                </a>
            </div>
        </div>

    </div>

</div>

<!-- Chart.js for SHAP -->
<% if (shapData.length > 0) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script id="shap-data" type="application/json">
<%- JSON.stringify(shapData) %>
</script>
<script>
(function() {
    const dataEl = document.getElementById('shap-data');
    if (!dataEl) return;
    let shap = [];
    try {
        shap = JSON.parse(dataEl.textContent || '[]');
    } catch (e) {
        shap = [];
    }
    const canvas = document.getElementById('shapChart');
    if (!canvas || !shap.length) return;

    const labels  = shap.map(s => s.feature);
    const values  = shap.map(s => s.shap_value);
    const colors  = shap.map(s => s.shap_value > 0 ? '#dc3545' : '#198754');
    const borders = shap.map(s => s.shap_value > 0 ? '#b02a37' : '#146c43');

    new Chart(canvas, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'SHAP Value (contribution to delay probability)',
                data: values,
                backgroundColor: colors,
                borderColor: borders,
                borderWidth: 1,
                borderRadius: 4,
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => {
                            const s = shap[ctx.dataIndex];
                            return ` ${s.direction} by ${s.impact_pct}% (SHAP: ${s.shap_value > 0 ? '+' : ''}${s.shap_value})`;
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { color: 'rgba(255,255,255,0.08)' },
                    ticks: { 
                        color: '#94A3B8',
                        callback: v => (v > 0 ? '+' : '') + (v * 100).toFixed(1) + '%' 
                    }
                },
                y: { 
                    grid: { display: false },
                    ticks: { color: '#CBD5E1' }
                }
            }
        }
    });
})();
</script>
<% } %>

<script>
(function() {
    var bar = document.getElementById('delayProgressBar');
    if (bar) {
        var w = bar.getAttribute('data-width') || '0';
        bar.style.width = w + '%';
    }
})();
</script>
