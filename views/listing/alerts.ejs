<% layout('layouts/boilerplate') %>

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-navy mb-1">
                <i class="bi bi-bell-fill text-danger me-2"></i> High-Risk Alerts
                <% if (alerts.length > 0) { %>
                <span class="badge bg-danger rounded-pill ms-2" style="font-size:14px;"><%= alerts.length %></span>
                <% } %>
            </h2>
            <p class="text-muted mb-0">Projects flagged with delay probability ≥ 65% — requiring immediate intervention</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/dashboard" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-bar-chart-line me-1"></i> Dashboard
            </a>
            <a href="/predict" class="btn btn-teal btn-sm fw-bold">
                <i class="bi bi-plus-circle me-1"></i> New Assessment
            </a>
        </div>
    </div>

    <!-- Alert Summary Banner -->
    <% if (alerts.length > 0) { %>
    <div class="alert alert-danger d-flex align-items-center gap-3 rounded-4 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-3 flex-shrink-0"></i>
        <div>
            <strong><%= alerts.length %> project<%= alerts.length > 1 ? 's' : '' %> require immediate attention.</strong>
            These cases have a predicted delay probability above 65%. Immediate intervention is recommended.
        </div>
    </div>
    <% } else { %>
    <div class="text-center py-5">
        <i class="bi bi-check-circle-fill text-success" style="font-size:4rem;"></i>
        <h4 class="fw-bold text-navy mt-3">No Active High-Risk Alerts</h4>
        <p class="text-muted">All currently assessed projects have delay probability below 65%.</p>
        <a href="/predict" class="btn btn-teal mt-2">Run New Assessment</a>
    </div>
    <% } %>

    <!-- Alert Cards -->
    <% alerts.forEach((c, idx) => { %>
    <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
        <div class="row g-0">

            <!-- Risk Severity Indicator Strip -->
            <div class="col-auto d-flex align-items-stretch">
                <div class="px-3 d-flex flex-column align-items-center justify-content-center text-white"
                     style="background: linear-gradient(180deg, #dc3545, #b02a37); min-width: 60px;">
                    <i class="bi bi-exclamation-triangle-fill fs-4 mb-1"></i>
                    <div class="small fw-bold text-center" style="writing-mode:horizontal-tb;">#<%= idx + 1 %></div>
                </div>
            </div>

            <div class="col p-4">
                <div class="row align-items-center">

                    <!-- Case Info -->
                    <div class="col-md-5 mb-3 mb-md-0">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-light text-dark border small"><%= c.case_id %></span>
                            <span class="badge bg-danger text-white">HIGH RISK</span>
                        </div>
                        <h5 class="fw-bold text-navy mb-1"><%= c.project_name || 'Infrastructure Project' %></h5>
                        <p class="text-muted small mb-0">
                            <i class="bi bi-geo-alt me-1"></i><%= c.state %> (<%= c.district_type %>) &nbsp;•&nbsp;
                            <i class="bi bi-building me-1"></i><%= c.project_type %> &nbsp;•&nbsp;
                            <i class="bi bi-calendar me-1"></i><%= c.days_since_case_opened %> days active
                        </p>
                    </div>

                    <!-- Probability & Stage -->
                    <div class="col-md-3 mb-3 mb-md-0 text-center">
                        <div class="text-muted small fw-semibold text-uppercase mb-1">Delay Probability</div>
                        <div class="display-6 fw-extrabold text-danger"><%= c.delay_probability_percent %></div>
                        <div class="progress mt-2" style="height:6px;">
                            <div class="progress-bar bg-danger"
                                 style="width:<%= Math.round(c.delay_probability * 100) %>%"></div>
                        </div>
                    </div>

                    <!-- Top Bottleneck -->
                    <div class="col-md-4">
                        <div class="text-muted small fw-semibold text-uppercase mb-2">Top Delay Drivers</div>
                        <% if (c.top_risk_factors && c.top_risk_factors.length > 0) { %>
                            <% c.top_risk_factors.slice(0, 2).forEach(f => { %>
                            <div class="d-flex align-items-start gap-2 mb-1">
                                <i class="bi bi-x-circle-fill text-danger flex-shrink-0 mt-1" style="font-size:12px;"></i>
                                <span class="small text-dark"><%= f %></span>
                            </div>
                            <% }) %>
                        <% } %>
                        <div class="mt-2">
                            <a href="/history/<%= c._id %>" class="btn btn-outline-danger btn-sm fw-semibold">
                                <i class="bi bi-arrow-right-circle me-1"></i> View Full Report
                            </a>
                        </div>
                    </div>

                </div>

                <!-- Recommended Action Preview -->
                <% if (c.recommended_preventive_actions && c.recommended_preventive_actions[0]) { %>
                <div class="mt-3 p-3 bg-danger-subtle rounded-3 d-flex gap-2 align-items-start">
                    <i class="bi bi-clipboard-check-fill text-danger flex-shrink-0 mt-1"></i>
                    <span class="small text-dark"><strong>Priority Action:</strong> <%= c.recommended_preventive_actions[0] %></span>
                </div>
                <% } %>

            </div>
        </div>
    </div>
    <% }) %>

</div>
