<% layout('layouts/boilerplate') %>

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-navy mb-1">
                <i class="bi bi-bell-fill text-white me-2"></i> High-Risk Alerts
                <% if (alerts.length > 0) { %>
                <span class="badge bg-danger rounded-pill ms-2" style="font-size:14px;"><%= alerts.length %></span>
                <% } %>
            </h2>
            <p class="text-muted mb-0">Projects flagged with delay probability ≥ 65% — requiring immediate intervention</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/dashboard" class="btn btn-gis-pill">
                <i class="bi bi-bar-chart-line-fill text-info"></i>
                <span>Analytics Dashboard</span>
            </a>
            <a href="/predict" class="btn btn-teal btn-sm fw-bold">
                <i class="bi bi-plus-circle me-1"></i> New Assessment
            </a>
        </div>
    </div>

    <!-- Alert Summary Banner -->
    <% if (alerts.length > 0) { %>
    <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 rounded-3 shadow-sm mb-3" role="alert" style="font-size: 0.875rem;">
        <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 text-danger"></i>
        <div>
            <strong><%= alerts.length %> project<%= alerts.length > 1 ? 's' : '' %> require immediate attention:</strong>
            Predicted delay probability &ge; 65%. Immediate CALA administrative intervention is recommended.
        </div>
    </div>
    <% } else { %>
    <div class="text-center py-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
        <h5 class="fw-bold text-navy mt-2">No Active High-Risk Alerts</h5>
        <p class="text-muted small">All currently assessed projects have delay probability below 65%.</p>
        <a href="/predict" class="btn btn-teal btn-sm mt-1">Run New Assessment</a>
    </div>
    <% } %>

    <!-- Alert Cards -->
    <% alerts.forEach((c, idx) => { %>
    <div class="card border-0 shadow-sm rounded-3 mb-2 overflow-hidden">
        <div class="row g-0">

            <!-- Risk Severity Indicator Strip -->
            <div class="col-auto d-flex align-items-stretch">
                <div class="px-2 py-2 d-flex flex-column align-items-center justify-content-center text-white"
                     style="background: linear-gradient(180deg, #dc3545, #b02a37); min-width: 44px;">
                    <i class="bi bi-exclamation-triangle-fill fs-6 mb-1"></i>
                    <div class="fw-bold text-center" style="font-size: 0.72rem;">#<%= idx + 1 %></div>
                </div>
            </div>

            <div class="col p-3">
                <div class="row align-items-center gy-2">

                    <!-- Case Info -->
                    <div class="col-md-5">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-light text-muted border" style="font-size: 0.7rem;"><%= c.case_id %></span>
                            <span class="badge bg-danger text-white" style="font-size: 0.68rem; padding: 0.25rem 0.5rem;">HIGH RISK</span>
                        </div>
                        <h6 class="fw-bold text-white mb-1" style="font-size: 0.95rem;"><%= c.project_name || 'Infrastructure Project' %></h6>
                        <p class="text-muted small mb-0" style="font-size: 0.78rem;">
                            <i class="bi bi-geo-alt me-1"></i><%= c.state %> (<%= c.district_type %>) &nbsp;•&nbsp;
                            <i class="bi bi-building me-1"></i><%= c.project_type %> &nbsp;•&nbsp;
                            <i class="bi bi-calendar me-1"></i><%= c.days_since_case_opened %>d active
                        </p>
                    </div>

                    <!-- Probability & Stage -->
                    <div class="col-md-3 text-center">
                        <div class="text-muted fw-semibold text-uppercase mb-1" style="font-size: 0.7rem;">Delay Probability</div>
                        <div class="fs-4 fw-extrabold text-danger lh-1"><%= c.delay_probability_percent %></div>
                        <div class="progress mt-1 mx-auto" style="height: 4px; max-width: 140px;">
                            <div class="progress-bar bg-danger"
                                 role="progressbar"
                                 data-width="<%= Math.round((c.delay_probability || 0) * 100) %>"></div>
                        </div>
                    </div>

                    <!-- Top Bottleneck -->
                    <div class="col-md-4">
                        <div class="text-muted fw-semibold text-uppercase mb-1" style="font-size: 0.7rem;">Top Delay Drivers</div>
                        <% if (c.top_risk_factors && c.top_risk_factors.length > 0) { %>
                            <% c.top_risk_factors.slice(0, 2).forEach(f => { %>
                            <div class="d-flex align-items-start gap-1 mb-1">
                                <i class="bi bi-x-circle-fill text-danger flex-shrink-0 mt-1" style="font-size:10px;"></i>
                                <span class="small text-light" style="font-size: 0.78rem;"><%= f %></span>
                            </div>
                            <% }) %>
                        <% } %>
                        <div class="mt-2 text-md-end">
                            <a href="/history/<%= c._id %>" class="btn btn-outline-danger btn-sm py-1 px-2 fw-semibold" style="font-size: 0.75rem; border-radius: 500px;">
                                <i class="bi bi-arrow-right-circle me-1"></i> Full Report
                            </a>
                        </div>
                    </div>

                </div>

                <!-- Recommended Action Preview -->
                <% if (c.recommended_preventive_actions && c.recommended_preventive_actions[0]) { %>
                <div class="mt-2 py-1 px-2 rounded-2 d-flex gap-2 align-items-center" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.22); font-size: 0.78rem;">
                    <i class="bi bi-clipboard-check-fill text-danger flex-shrink-0"></i>
                    <span style="color: #FCA5A5;"><strong class="text-white">Priority Action:</strong> <%= c.recommended_preventive_actions[0] %></span>
                </div>
                <% } %>

            </div>
        </div>
    </div>
    <% }) %>

</div>

<script>
    document.querySelectorAll('.progress-bar[data-width]').forEach(function(bar) {
        bar.style.width = bar.getAttribute('data-width') + '%';
    });
</script>
