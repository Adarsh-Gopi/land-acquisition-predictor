<% layout('layouts/boilerplate') %>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    #map { height: calc(100vh - 160px); min-height: 500px; border-radius: 16px; }
    .risk-legend { background: white; padding: 12px 16px; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.15); font-size: 13px; }
    .risk-legend h6 { font-size: 13px; font-weight: 700; margin-bottom: 8px; }
    .legend-dot { width: 14px; height: 14px; border-radius: 50%; display: inline-block; margin-right: 6px; }
    .leaflet-popup-content { font-size: 13px; min-width: 220px; }
    .popup-title { font-weight: 700; font-size: 14px; margin-bottom: 4px; }
</style>

<div class="container-fluid py-3 px-4">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="fw-bold text-navy mb-1"><i class="bi bi-map-fill text-success me-2"></i>GIS Risk Map</h2>
            <p class="text-muted mb-0">State-wise geographic distribution of assessed land acquisition projects</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/dashboard" class="btn btn-outline-primary btn-sm fw-semibold">
                <i class="bi bi-bar-chart-line me-1"></i> Analytics Dashboard
            </a>
            <a href="/predict" class="btn btn-teal btn-sm fw-bold">
                <i class="bi bi-plus-circle me-1"></i> New Assessment
            </a>
        </div>
    </div>

    <!-- Quick Stats Row -->
    <div class="row g-2 mb-3">
        <div class="col-4 col-md-2">
            <div class="card border-0 shadow-sm rounded-3 p-2 text-center">
                <div class="fw-bold text-danger fs-5"><%= mapCases.filter(c=>c.risk_level==='High').length %></div>
                <div class="small text-muted">High Risk</div>
            </div>
        </div>
        <div class="col-4 col-md-2">
            <div class="card border-0 shadow-sm rounded-3 p-2 text-center">
                <div class="fw-bold text-warning fs-5"><%= mapCases.filter(c=>c.risk_level==='Medium').length %></div>
                <div class="small text-muted">Medium Risk</div>
            </div>
        </div>
        <div class="col-4 col-md-2">
            <div class="card border-0 shadow-sm rounded-3 p-2 text-center">
                <div class="fw-bold text-success fs-5"><%= mapCases.filter(c=>c.risk_level==='Low').length %></div>
                <div class="small text-muted">Low Risk</div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-2 d-flex flex-row align-items-center gap-2 px-3">
                <i class="bi bi-info-circle text-primary"></i>
                <span class="small text-muted">Markers are plotted at approximate state capitals. Click any marker to view full case details.</span>
            </div>
        </div>
    </div>

    <!-- Map -->
    <div id="map" class="shadow-sm border"></div>

</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
// Cases from server
const cases = <%- JSON.stringify(mapCases) %>;

// State → [lat, lng] approximate coordinates (state capitals / geographic centers)
const stateCoords = {
    "Uttar Pradesh":    [26.8467, 80.9462],
    "Punjab":           [31.1471, 75.3412],
    "Maharashtra":      [19.7515, 75.7139],
    "Rajasthan":        [27.0238, 74.2179],
    "Madhya Pradesh":   [22.9734, 78.6569],
    "West Bengal":      [22.9868, 87.8550],
    "Chhattisgarh":     [21.2787, 81.8661],
    "Odisha":           [20.9517, 85.0985],
    "Haryana":          [29.0588, 76.0856],
    "Karnataka":        [15.3173, 75.7139],
    "Gujarat":          [22.2587, 71.1924],
    "Bihar":            [25.0961, 85.3131],
    "Andhra Pradesh":   [15.9129, 79.7400],
    "Telangana":        [17.1232, 79.2088],
    "Tamil Nadu":       [11.1271, 78.6569],
    "Kerala":           [10.8505, 76.2711],
    "Jharkhand":        [23.6102, 85.2799],
    "Assam":            [26.2006, 92.9376],
    "Uttarakhand":      [30.0668, 79.0193],
    "Himachal Pradesh": [31.1048, 77.1734]
};

const riskColors = { 'High': '#dc3545', 'Medium': '#fd7e14', 'Low': '#198754' };
const riskIcons = { 'High': '🔴', 'Medium': '🟠', 'Low': '🟢' };

// Init map centered on India
const map = L.map('map').setView([22.5, 82.0], 5);

// Tile layer
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© <a href="https://www.openstreetmap.org/">OpenStreetMap</a> contributors',
    maxZoom: 18
}).addTo(map);

// Add markers
const grouped = {};
cases.forEach(c => {
    const coords = stateCoords[c.state];
    if (!coords) return;

    // Jitter multiple cases in same state so they don't overlap
    if (!grouped[c.state]) grouped[c.state] = 0;
    grouped[c.state]++;
    const count = grouped[c.state];
    const jitterLat = coords[0] + (Math.random() - 0.5) * 1.8;
    const jitterLng = coords[1] + (Math.random() - 0.5) * 1.8;

    const color = riskColors[c.risk_level] || '#6c757d';

    const icon = L.divIcon({
        className: '',
        html: `<div style="
            width:34px; height:34px; border-radius:50%;
            background:${color}; border:3px solid white;
            box-shadow:0 2px 8px rgba(0,0,0,0.35);
            display:flex; align-items:center; justify-content:center;
            color:white; font-size:13px; font-weight:700;
        ">${c.delay_probability ? Math.round(c.delay_probability * 100) : '?'}</div>`,
        iconSize: [34, 34],
        iconAnchor: [17, 17]
    });

    const factors = Array.isArray(c.top_risk_factors) ? c.top_risk_factors.slice(0, 2).join('<br>• ') : 'N/A';
    const popup = `
        <div class="popup-title">${riskIcons[c.risk_level]} ${c.project_name || 'Project'}</div>
        <div style="color:#6c757d; font-size:12px;">${c.case_id} &nbsp;|&nbsp; ${c.state}</div>
        <hr style="margin:6px 0;">
        <div><b>Sector:</b> ${c.project_type}</div>
        <div><b>Risk Tier:</b> <span style="color:${color}; font-weight:700;">${c.risk_level} Risk</span></div>
        <div><b>Delay Probability:</b> ${c.delay_probability_percent || 'N/A'}</div>
        <div style="margin-top:6px;"><b>Top Drivers:</b><br>• ${factors}</div>
        <div style="margin-top:8px;">
            <a href="/history/${c._id}" style="color:#0d6efd; font-size:12px;">View Full Report →</a>
        </div>`;

    L.marker([jitterLat, jitterLng], { icon })
        .addTo(map)
        .bindPopup(popup, { maxWidth: 280 });
});

// Legend
const legend = L.control({ position: 'bottomright' });
legend.onAdd = function() {
    const div = L.DomUtil.create('div', 'risk-legend');
    div.innerHTML = `
        <h6><i class="bi bi-shield-fill"></i> Risk Level</h6>
        <div><span class="legend-dot" style="background:#dc3545"></span> High Risk</div>
        <div><span class="legend-dot" style="background:#fd7e14"></span> Medium Risk</div>
        <div><span class="legend-dot" style="background:#198754"></span> Low Risk</div>
        <hr style="margin:8px 0; border-color:#dee2e6;">
        <div style="font-size:11px;color:#6c757d;">Number = Delay %</div>`;
    return div;
};
legend.addTo(map);

// Fit map to markers if any
if (cases.length > 0) {
    const validCoords = cases
        .filter(c => stateCoords[c.state])
        .map(c => stateCoords[c.state]);
    if (validCoords.length > 0) {
        map.fitBounds(L.latLngBounds(validCoords).pad(0.3));
    }
}
</script>
